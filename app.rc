// Ресурсный файл Windows — единственное назначение здесь: вшить иконку
// в сам .exe (та, что видна в Проводнике/на ярлыке/в панели задач ДО
// запуска игры). Иконка ОКНА во время игры — отдельный, независимый
// механизм (glfwSetWindowIcon() в WindowManager.cpp, грузит assets/icon.png
// во время выполнения) — эти две иконки НЕ связаны друг с другом,
// поменять одну не поменяет другую.
IDI_ICON1 ICON "assets/icon.ico"
